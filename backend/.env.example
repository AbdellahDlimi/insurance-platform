# === Base de données PostgreSQL (depuis docker-compose.yml) ===
DATABASE_URL=postgresql://admin:password@localhost:5432/insurance_db

# === Kafka (port EXTERNAL exposé par docker-compose) ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# === Clé Fernet (chiffrement symétrique) ===
FERNET_KEY=CHANGER_MOI__generer_avec_Fernet.generate_key()

# === Clé secrète JWT (authentification) ===
JWT_SECRET_KEY=CHANGER_MOI__mettre_une_chaine_aleatoire_longue

# === api key resend ===
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# === Configuration SMTP (envoi d'emails) ===
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=dev_user
SMTP_PASSWORD=dev_password
SMTP_FROM=onboarding@resend.dev
SMTP_USE_TLS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DEV_EMAIL_OVERRIDE=votre_email@gmail.com

#== stripe ===
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_STRIPE
STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_WEBHOOK_SECRET

#== AI / RAG (Gemini) ===
# Créer une clé GRATUITE sur https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_LLM_MODEL=gemini-2.0-flash
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3

